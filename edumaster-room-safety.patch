diff --git a/app/lib/meetingLinkGuard.js b/app/lib/meetingLinkGuard.js
new file mode 100644
index 0000000..5e23f5a
--- /dev/null
+++ b/app/lib/meetingLinkGuard.js
@@ -0,0 +1,27 @@
+// app/lib/meetingLinkGuard.js
+//
+// 🔒 منع تغيير رابط محاضرة Daily أثناء وجود الغرفة "حيّة".
+//
+// ليه؟ تعديل اللينك لمحاضرة Daily في PUT /api/meetings/[id] بيمسح غرفة Daily
+// ويحوّل المحاضرة لـ "manual" برابط تاني. لو ده حصل والناس جوه الغرفة أو على وشك
+// الدخول، اللي جوه بيتطردوا واللي يدخل بعد كده بيروح لمكان تاني = المدرس في مكان
+// والطلاب في مكان (نفس نتيجة مشكلة حصة 6/11).
+//
+// القفل بيغطي الفترة اللي الغرفة فيها قابلة للاستخدام فعليًا (الغرفة بتفتح قبل المعاد
+// بربع ساعة وبتقفل بعد النهاية بساعتين — شوف createDailyRoom في app/lib/daily.js)
+// + هامش أمان قبل البداية.
+
+export const LINK_LOCK_BEFORE_MS = 60 * 60 * 1000; // ساعة قبل المعاد
+export const LINK_LOCK_AFTER_MS = 2 * 60 * 60 * 1000; // لحد نهاية صلاحية الغرفة (end + ساعتين)
+
+/**
+ * هل تغيير رابط المحاضرة دي ممنوع دلوقتي؟
+ * بس لمحاضرات Daily (اللينك اليدوي مالوش غرفة عندنا نمسحها).
+ */
+export function isLinkChangeLocked(meeting, now = Date.now()) {
+  if (!meeting || meeting.source !== "daily") return false;
+  const start = new Date(meeting.scheduledAt).getTime();
+  if (Number.isNaN(start)) return false;
+  const end = start + (meeting.durationMinutes || 60) * 60 * 1000;
+  return now >= start - LINK_LOCK_BEFORE_MS && now <= end + LINK_LOCK_AFTER_MS;
+}
diff --git a/app/lib/meetingLinkGuard.test.js b/app/lib/meetingLinkGuard.test.js
new file mode 100644
index 0000000..74303a9
--- /dev/null
+++ b/app/lib/meetingLinkGuard.test.js
@@ -0,0 +1,30 @@
+// app/lib/meetingLinkGuard.test.js
+import { isLinkChangeLocked, LINK_LOCK_BEFORE_MS, LINK_LOCK_AFTER_MS } from "@/app/lib/meetingLinkGuard";
+
+const START = new Date("2026-11-10T15:00:00Z").getTime();
+const m = (over = {}) => ({ source: "daily", scheduledAt: new Date(START), durationMinutes: 60, ...over });
+const END = START + 60 * 60_000;
+
+describe("isLinkChangeLocked", () => {
+  it("قبل المعاد بأكتر من ساعة → مسموح", () => {
+    expect(isLinkChangeLocked(m(), START - LINK_LOCK_BEFORE_MS - 1)).toBe(false);
+  });
+  it("قبل المعاد بساعة بالظبط → ممنوع", () => {
+    expect(isLinkChangeLocked(m(), START - LINK_LOCK_BEFORE_MS)).toBe(true);
+  });
+  it("أثناء المحاضرة → ممنوع", () => {
+    expect(isLinkChangeLocked(m(), START + 10 * 60_000)).toBe(true);
+  });
+  it("بعد النهاية وجوه صلاحية الغرفة (ساعتين) → ممنوع", () => {
+    expect(isLinkChangeLocked(m(), END + LINK_LOCK_AFTER_MS)).toBe(true);
+  });
+  it("بعد انتهاء صلاحية الغرفة → مسموح", () => {
+    expect(isLinkChangeLocked(m(), END + LINK_LOCK_AFTER_MS + 1)).toBe(false);
+  });
+  it("لينك يدوي (manual) → مسموح دايمًا", () => {
+    expect(isLinkChangeLocked(m({ source: "manual" }), START + 1)).toBe(false);
+  });
+  it("المدة الافتراضية 60 دقيقة لو مش متحددة", () => {
+    expect(isLinkChangeLocked(m({ durationMinutes: undefined }), END + 1)).toBe(true);
+  });
+});
