+ * بسبب إعادة الحساب (والنسبة هتتصحح تلقائي في أول مرة طالب يكمل حاجة).
+ *
+ * @returns {Promise<{updated:number, newlyCompleted:number}|null>}
+ */
+export async function recomputeCourseProgress(courseId) {
+  try {
+    const Lesson = getLessonModel();
+    const Enrollment = getEnrollmentModel();
+    const Quiz = getQuizModel();
+    const QuizResult = getQuizResultModel();
+
+    const [nonQuizLessons, quizzes, enrollments] = await Promise.all([
+      Lesson.find({ course: courseId, type: { $ne: "quiz" } }, "_id").lean(),
+      Quiz.find({ course: courseId, isPublished: true }, "_id").lean(),
+      Enrollment.find(
+        { course: courseId, status: { $ne: "cancelled" } },
+        "user status progressPercent completedLessons"
+      ).lean(),
+    ]);
+    if (enrollments.length === 0) return { updated: 0, newlyCompleted: 0 };
+
+    const nonQuizLessonIds = nonQuizLessons.map((l) => l._id);
+    const publishedQuizIds = quizzes.map((q) => q._id);
+
+    const passedByStudent = new Map(); // studentId → [quizId]
+    if (publishedQuizIds.length > 0) {
+      const passed = await QuizResult.find(
+        {
+          course: courseId,
+          quiz: { $in: publishedQuizIds },
+          student: { $in: enrollments.map((e) => e.user) },
+          passed: true,
+        },
+        "student quiz"
+      ).lean();
+      for (const r of passed) {
+        const key = r.student.toString();
+        if (!passedByStudent.has(key)) passedByStudent.set(key, []);
+        passedByStudent.get(key).push(r.quiz);
+      }
+    }
+
+    const ops = [];
+    const newlyCompletedUsers = [];
+    for (const e of enrollments) {
+      const { progressPercent, isComplete } = computeProgress({
+        nonQuizLessonIds,
+        publishedQuizIds,
+        completedLessonIds: e.completedLessons || [],
+        passedQuizIds: passedByStudent.get(e.user.toString()) || [],
+      });
+
+      const wasComplete = e.status === "completed";
+      const $set = {};
+      if (progressPercent !== (e.progressPercent || 0)) $set.progressPercent = progressPercent;
+      if (isComplete && !wasComplete) {
+        $set.status = "completed";
+        $set.completedAt = new Date();
+        newlyCompletedUsers.push(e.user);
+      } else if (!isComplete && wasComplete) {
+        $set.status = "active";
+        $set.completedAt = null;
+      }
+
+      if (Object.keys($set).length > 0) {
+        ops.push({ updateOne: { filter: { _id: e._id }, update: { $set } } });
+      }
+    }
+
+    if (ops.length > 0) await Enrollment.bulkWrite(ops, { ordered: false });
+
+    // نفس سلوك recomputeEnrollmentProgress: اللي بقى مكتمل دلوقتي ياخد شهادته
+    // (مثلاً المدرس مسح آخر عنصر ناقص). بتتنفذ ورا بعض عشان ما نضغطش الـ DB.
+    for (const userId of newlyCompletedUsers) {
+      await issueCertificateForCompletedEnrollment(userId, courseId);
+    }
+
+    return { updated: ops.length, newlyCompleted: newlyCompletedUsers.length };
+  } catch (err) {
+    console.error("[progressHelpers] recomputeCourseProgress failed:", err);
+    return null;
+  }
+}
diff --git a/app/lib/progressMath.js b/app/lib/progressMath.js
new file mode 100644
index 0000000..fbe2e57
--- /dev/null
+++ b/app/lib/progressMath.js
@@ -0,0 +1,84 @@
+// app/lib/progressMath.js
+//
+// منطق حساب خالص (من غير DB ولا imports) لنسبة إكمال الكورس واختيار "أفضل
+// نتيجة" كويز. اتفصل عن progressHelpers.js عشان:
+//   1) نفس القاعدة بالظبط تتستخدم في كل مكان (تحديث الـ enrollment، وصفحة
+//      أداء الطلاب للمدرس) فمستحيل الرقم يختلف من شاشة لشاشة.
+//   2) يتختبر بسهولة من غير mocks.
+
+/**
+ * نسبة إكمال الكورس.
+ *
+ * عنصر الإكمال = (دروس غير-الكويز) + (الكويزات المنشورة). درس النوع "quiz"
+ * نفسه ما بيتحسبش مرتين — إكماله بيتحدد من نجاح الكويز المرتبط بيه.
+ *
+ * 🔒 "مكتمل" بيتحدد بالعدّ الفعلي (completedItems >= totalItems) مش من النسبة
+ * المقرّبة. قبل كده Math.round كان بيطلّع 199/200 = 100% فيتعلّم الكورس مكتمل
+ * وتتصدر الشهادة وفاضل عنصر. ولو الكورس مش مكتمل فعليًا النسبة بتتسقّف عند 99%.
+ *
+ * @param {object} p
+ * @param {Array<string|object>} p.nonQuizLessonIds  دروس الكورس اللي type != quiz
+ * @param {Array<string|object>} p.publishedQuizIds  كويزات الكورس المنشورة
+ * @param {Array<string|object>} p.completedLessonIds enrollment.completedLessons
+ * @param {Array<string|object>} p.passedQuizIds     كويزات الطالب اللي نجح في أي محاولة منها
+ */
+export function computeProgress({
+  nonQuizLessonIds = [],
+  publishedQuizIds = [],
+  completedLessonIds = [],
+  passedQuizIds = [],
+}) {
+  const completedSet = new Set(completedLessonIds.map(String));
+  const passedSet = new Set(passedQuizIds.map(String));
+
+  const completedLessonItems = nonQuizLessonIds.filter((id) => completedSet.has(String(id))).length;
+  const passedQuizItems = publishedQuizIds.filter((id) => passedSet.has(String(id))).length;
+
+  const totalItems = nonQuizLessonIds.length + publishedQuizIds.length;
+  const completedItems = completedLessonItems + passedQuizItems;
+  const isComplete = totalItems > 0 && completedItems >= totalItems;
+
+  let progressPercent = totalItems === 0 ? 0 : Math.round((completedItems / totalItems) * 100);
+  if (isComplete) progressPercent = 100;
+  else if (progressPercent >= 100) progressPercent = 99;
+
+  return { totalItems, completedItems, completedLessonItems, passedQuizItems, progressPercent, isComplete };
+}
+
+/** محاولة كويز لسه مستنية تصحيح يدوي (أسئلة مقالية). المحاولات القديمة من غير status = graded. */
+export function isPendingReview(result) {
+  return result?.status === "pending_review";
+}
+
+/**
+ * أفضل نتيجة لطالب في كويز واحد، من كل محاولاته.
+ *
+ * - المحاولات المعلّقة (pending_review) بتتتجاهل: درجتها مؤقتة (الاختياري بس)
+ *   و passed=false لحد ما المقالي يتصحح، فمينفعش تتعرض "راسب" ولا تغلب
+ *   محاولة سابقة اتصححت.
+ * - المحاولة الناجحة بتتفضّل على غير الناجحة (عشان العرض يطابق حساب التقدّم
+ *   اللي بيعتبر الكويز منجوح لو أي محاولة نجحت)، وبعدها الأعلى درجة.
+ *
+ * @param {Array<{scorePercent:number, passed:boolean, status?:string, attemptNumber?:number}>} results
+ * @returns {{ best: object|null, hasPendingReview: boolean, attemptsCount: number }}
+ */
+export function pickBestQuizResult(results = []) {
+  let best = null;
+  let hasPendingReview = false;
+
+  for (const r of results) {
+    if (isPendingReview(r)) {
+      hasPendingReview = true;
+      continue;
+    }
+    if (!best) {
+      best = r;
+      continue;
+    }
+    const rPassed = Boolean(r.passed);
+    const bestPassed = Boolean(best.passed);
+    if (rPassed !== bestPassed ? rPassed : r.scorePercent > best.scorePercent) best = r;
+  }
+
+  return { best, hasPendingReview, attemptsCount: results.length };
+}
diff --git a/app/lib/progressMath.test.js b/app/lib/progressMath.test.js
new file mode 100644
index 0000000..4b7e95b
--- /dev/null
+++ b/app/lib/progressMath.test.js
@@ -0,0 +1,103 @@
+// app/lib/progressMath.test.js
+//
+// بيثبّت قواعد حساب أداء الطلاب: نسبة الإكمال (بدون تقريب بيكمّل كورس ناقص)
+// واختيار أفضل نتيجة كويز (من غير ما محاولة معلّقة تتعرض "راسب").
+
+import { computeProgress, pickBestQuizResult, isPendingReview } from "./progressMath.js";
+
+const ids = (n, prefix) => Array.from({ length: n }, (_, i) => `${prefix}${i}`);
+
+describe("computeProgress", () => {
+  it("returns 0% and not complete for a course with no items", () => {
+    expect(computeProgress({})).toMatchObject({ totalItems: 0, progressPercent: 0, isComplete: false });
+  });
+
+  it("counts non-quiz lessons plus published quizzes, each once", () => {
+    const r = computeProgress({
+      nonQuizLessonIds: ["l1", "l2"],
+      publishedQuizIds: ["q1"],
+      completedLessonIds: ["l1", "q-lesson-should-be-ignored"],
+      passedQuizIds: ["q1"],
+    });
+    expect(r).toMatchObject({ totalItems: 3, completedItems: 2, progressPercent: 67, isComplete: false });
+  });
+
+  it("ignores passed quizzes that are not published (not in publishedQuizIds)", () => {
+    const r = computeProgress({ publishedQuizIds: ["q1"], passedQuizIds: ["q1", "unpublished"] });
+    expect(r).toMatchObject({ totalItems: 1, completedItems: 1, isComplete: true, progressPercent: 100 });
+  });
+
+  it("does not double count duplicate completed lesson ids", () => {
+    const r = computeProgress({ nonQuizLessonIds: ["l1", "l2"], completedLessonIds: ["l1", "l1", "l1"] });
+    expect(r).toMatchObject({ completedItems: 1, progressPercent: 50 });
+  });
+
+  it("is complete only when every item is done", () => {
+    const r = computeProgress({
+      nonQuizLessonIds: ["l1", "l2"],
+      publishedQuizIds: ["q1"],
+      completedLessonIds: ["l1", "l2"],
+      passedQuizIds: ["q1"],
+    });
+    expect(r).toMatchObject({ progressPercent: 100, isComplete: true });
+  });
+
+  it("does NOT mark 199/200 as complete (rounding used to give 100%)", () => {
+    const lessons = ids(200, "l");
+    const r = computeProgress({ nonQuizLessonIds: lessons, completedLessonIds: lessons.slice(0, 199) });
+    expect(r.isComplete).toBe(false);
+    expect(r.progressPercent).toBe(99);
+  });
+
+  it("does NOT mark 299/300 as complete", () => {
+    const lessons = ids(300, "l");
+    const r = computeProgress({ nonQuizLessonIds: lessons, completedLessonIds: lessons.slice(0, 299) });
+    expect(r).toMatchObject({ isComplete: false, progressPercent: 99 });
+  });
+
+  it("accepts ObjectId-like values (compared by string)", () => {
+    const oid = (s) => ({ toString: () => s });
+    const r = computeProgress({ nonQuizLessonIds: [oid("a")], completedLessonIds: [oid("a")] });
+    expect(r.isComplete).toBe(true);
+  });
+});
+
+describe("pickBestQuizResult", () => {
+  it("returns null best for no attempts", () => {
+    expect(pickBestQuizResult([])).toEqual({ best: null, hasPendingReview: false, attemptsCount: 0 });
+  });
+
+  it("picks the highest score among graded attempts", () => {
+    const a = { scorePercent: 40, passed: false };
+    const b = { scorePercent: 90, passed: true };
+    const c = { scorePercent: 70, passed: true };
+    expect(pickBestQuizResult([a, b, c]).best).toBe(b);
+  });
+
+  it("treats legacy results without status as graded", () => {
+    const a = { scorePercent: 50, passed: false };
+    expect(isPendingReview(a)).toBe(false);
+    expect(pickBestQuizResult([a]).best).toBe(a);
+  });
+
+  it("ignores a pending_review attempt even if its temporary score is higher", () => {
+    const graded = { scorePercent: 70, passed: true, status: "graded" };
+    const pending = { scorePercent: 80, passed: false, status: "pending_review" };
+    const out = pickBestQuizResult([graded, pending]);
+    expect(out.best).toBe(graded);
+    expect(out.hasPendingReview).toBe(true);
+    expect(out.attemptsCount).toBe(2);
+  });
+
+  it("returns best=null with hasPendingReview when the only attempt is pending", () => {
+    const pending = { scorePercent: 30, passed: false, status: "pending_review" };
+    expect(pickBestQuizResult([pending])).toEqual({ best: null, hasPendingReview: true, attemptsCount: 1 });
+  });
+
+  it("prefers a passed attempt over a higher-scoring failed one (passing score was raised later)", () => {
+    const failedHigh = { scorePercent: 75, passed: false, status: "graded" };
+    const passedLow = { scorePercent: 65, passed: true, status: "graded" };
+    expect(pickBestQuizResult([failedHigh, passedLow]).best).toBe(passedLow);
+    expect(pickBestQuizResult([passedLow, failedHigh]).best).toBe(passedLow);
+  });
+});
