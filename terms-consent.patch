diff --git a/app/components/TermsConsent.jsx b/app/components/TermsConsent.jsx
new file mode 100644
index 0000000..f416210
--- /dev/null
+++ b/app/components/TermsConsent.jsx
@@ -0,0 +1,81 @@
+"use client";
+
+// app/components/TermsConsent.jsx
+//
+// 🆕 خانة "أوافق على الشروط والأحكام" المشتركة — بتتحط في كل فورمات الموقع
+// (contact / quick-inquiry / الاستشارة / الترجمة / المنح / البرامج /
+// Call Center / التسجيل). بتربط بصفحات الشروط والخصوصية والاسترداد الموجودة
+// فعلاً (/terms, /privacy, /refund) وبتفتحهم في تاب جديد عشان المستخدم ما
+// يفقدش اللي كتبه في الفورم.
+//
+// الاستخدام:
+//   const [termsAccepted, setTermsAccepted] = useState(false);
+//   <TermsConsent checked={termsAccepted} onChange={setTermsAccepted} lang={language} error={showError} />
+
+const TEXT = {
+  ar: {
+    prefix: "أوافق على ",
+    terms: "الشروط والأحكام",
+    and1: "، ",
+    privacy: "سياسة الخصوصية",
+    and2: " و",
+    refund: "سياسة الاسترداد",
+    suffix: " الخاصة بـ Edumaster. *",
+    required: "يجب الموافقة على الشروط والأحكام للمتابعة",
+  },
+  en: {
+    prefix: "I agree to the ",
+    terms: "Terms & Conditions",
+    and1: ", ",
+    privacy: "Privacy Policy",
+    and2: " and ",
+    refund: "Refund Policy",
+    suffix: " of Edumaster. *",
+    required: "You must accept the Terms & Conditions to continue",
+  },
+  es: {
+    prefix: "Acepto los ",
+    terms: "Términos y Condiciones",
+    and1: ", la ",
+    privacy: "Política de Privacidad",
+    and2: " y la ",
+    refund: "Política de Reembolso",
+    suffix: " de Edumaster. *",
+    required: "Debes aceptar los Términos y Condiciones para continuar",
+  },
+};
+
+export function termsRequiredMessage(lang) {
+  return (TEXT[lang] || TEXT.en).required;
+}
+
+export default function TermsConsent({ checked, onChange, lang = "en", error = false, className = "" }) {
+  const t = TEXT[lang] || TEXT.en;
+  const linkCls = "text-[#003A91] font-semibold underline";
+  return (
+    <div className={className}>
+      <label
+        className={`flex items-start gap-2.5 text-xs sm:text-sm ${error ? "text-red-600" : "text-gray-600"}`}
+      >
+        <input
+          type="checkbox"
+          required
+          className="mt-0.5 w-4 h-4 shrink-0 accent-[#003A91]"
+          checked={checked}
+          onChange={(e) => onChange(e.target.checked)}
+          aria-invalid={error ? "true" : "false"}
+        />
+        <span>
+          {t.prefix}
+          <a href="/terms" target="_blank" rel="noopener noreferrer" className={linkCls}>{t.terms}</a>
+          {t.and1}
+          <a href="/privacy" target="_blank" rel="noopener noreferrer" className={linkCls}>{t.privacy}</a>
+          {t.and2}
+          <a href="/refund" target="_blank" rel="noopener noreferrer" className={linkCls}>{t.refund}</a>
+          {t.suffix}
+        </span>
+      </label>
+      {error && <p className="text-red-500 text-xs font-medium mt-1">{t.required}</p>}
+    </div>
+  );
+}
